#!/bin/sh
#
# smokeping-mtr-alert - SmokePing "pipe" alert handler.
#
# Runs an MTR report towards the alerting target - on the remote probe that
# measured it, when the target is measured by one - and mails it together with
# a deep link to, and an inline image of, the graph that triggered the alert.
#
# Everything else is read from the SmokePing configuration: recipients, sender,
# installation name, CGI URL, data directory, graph size and time range, which
# probe measures the target and how that probe reaches its remote host, and the
# MTA to hand the message to. There is nothing to configure here and no wrapper
# script to write.
#
# SmokePing calls alert programs with 5 positional arguments (6 when the alert
# has "edgetrigger = yes"):
#
#   1 name-of-alert   2 target   3 loss-pattern   4 rtt-pattern   5 hostname
#   6 state           (1 = raised, 0 = cleared; only with edgetrigger = yes)
#
# Argument 2 is the dotted target path SmokePing itself puts in "?target=" when
# it sends its own alert mail, so the graph URL, the RRD and the probe that
# measured the target can all be looked up from it.
#
# POSIX sh rewrite of smokeping-mtr-alert by Michael Fincham
# <michael.fincham@catalyst.net.nz>, Copyright (c) 2016 Catalyst.net Ltd,
# https://github.com/catalyst/smokeping-mtr-alert
#
# This program is free software: you can redistribute it and/or modify it under
# the terms of the GNU General Public License as published by the Free Software
# Foundation, either version 3 of the License, or (at your option) any later
# version. This program is distributed in the hope that it will be useful, but
# WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
# FITNESS FOR A PARTICULAR PURPOSE. See <http://www.gnu.org/licenses/>.

set -u

PROG=${0##*/}
DRY_RUN=''
VERBOSE=''

# Options passed to mtr, locally and on a remote probe alike.
MTR_OPTS="-w --report -z --show-ips -c 20"
MTR_TIMEOUT=180

usage() {
	cat <<EOF
usage: $PROG [-n] [-v] <alert> <target> <loss-pattern> <rtt-pattern> <hostname> [state]

Called by SmokePing as a pipe alert:

  *** Alerts ***
  to = |/usr/local/bin/$PROG
  from = smokeping@example.org

All settings come from the SmokePing configuration. Set SMOKEPING_CONFIG in the
environment if it is not in one of the usual places.

  -n, --dry-run   print the message on stdout instead of sending it
  -v, --verbose   report what was read from the config and how the mail was sent
  -h, --help      this text
EOF
}

die() { echo "$PROG: $*" >&2; exit 1; }
warn() { echo "$PROG: $*" >&2; }
info() { [ -z "$VERBOSE" ] || echo "$PROG: $*" >&2; }

# true when the argument is plain printable ASCII. Done with tr rather than a
# [!\ -~] case pattern, which older shells refuse to parse.
is_ascii() {
	[ -z "$(printf '%s' "$1" | LC_ALL=C tr -d ' -~')" ]
}

# minimal HTML escaping for text that goes into the HTML part
esc() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

while [ $# -gt 0 ]; do
	case $1 in
		-n|--dry-run) DRY_RUN=1 ;;
		-v|--verbose) VERBOSE=1 ;;
		-h|--help)    usage; exit 0 ;;
		--)           shift; break ;;
		-*)           usage >&2; die "unknown option: $1" ;;
		*)            break ;;
	esac
	shift
done

[ $# -ge 5 ] || { usage >&2; exit 1; }

alert=$1 target=$2 loss=$3 rtt=$4 host=$5
state=${6:-}

info "$PROG starting for target $2"
now=$(date +%s)
localhost=$(hostname -f 2>/dev/null) || localhost=
[ -n "$localhost" ] || localhost=$(uname -n)

# In a distributed setup - the one SmokePing configures under "*** Slaves ***",
# where other SmokePing instances report in - the alert target carries a
# " [from <name>]" suffix. A normal installation never produces one. Split it
# off so the rest of the target string is the plain path SmokePing uses.
path=$target reporter=''
case $target in
*' [from '*']')
	path=${target%% \[from *}
	reporter=${target##* \[from }
	reporter=${reporter%\]}
	;;
esac

# ------------------------------------------------ the SmokePing config file ---

CONFIG=${SMOKEPING_CONFIG:-}
if [ -z "$CONFIG" ]; then
	for c in /etc/smokeping/config /usr/local/smokeping/etc/config \
	         /usr/local/etc/smokeping/config /opt/smokeping/etc/config \
	         /etc/smokeping.conf; do
		[ -r "$c" ] && { CONFIG=$c; break; }
	done
fi
if [ -z "$CONFIG" ] || [ ! -r "$CONFIG" ]; then
	die "no readable SmokePing config found, set SMOKEPING_CONFIG"
fi

# Config::Grammar resolves @include relative to the including file, so splice
# the tree together before parsing it.
flatten() {
	_f=$1 _d=$2
	[ "$_d" -gt 16 ] && { warn "@include nested too deep at $_f"; return; }
	[ -r "$_f" ] || { warn "cannot read $_f"; return; }
	case $_f in */*) _dir=${_f%/*} ;; *) _dir=. ;; esac
	sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$_f" |
	while IFS= read -r _l; do
		case $_l in
		'@include '*|'@include	'*)
			_i=${_l#@include}
			while :; do
				case $_i in
					' '*|'	'*) _i=${_i#?} ;;
					*) break ;;
				esac
			done
			case $_i in *'#'*) _i=${_i%%#*} ;; esac
			while :; do
				case $_i in
					*' '|*'	') _i=${_i%?} ;;
					*) break ;;
				esac
			done
			case $_i in /*) ;; *) _i="$_dir/$_i" ;; esac
			_next=$((_d + 1))
			# a subshell, so this file's own $_f and $_dir survive
			( flatten "$_i" "$_next" )
			;;
		'@define '*)
			warn "@define is not expanded by $PROG"
			printf '%s\n' "$_l" ;;
		*)
			printf '%s\n' "$_l" ;;
		esac
	done
}

# One pass over the flattened config, emitting shell assignments. Section and
# subsection depth are tracked the way Config::Grammar nests them, so a value is
# only taken from the section it belongs to. "alertee" and "probe" are collected
# along the path to this target, deepest definition winning, which is how
# SmokePing inherits them; the probe's own settings are then looked up in the
# Probes section, where a probe may be a module section or an instance under one.
eval "$(flatten "$CONFIG" 0 | awk -v alert="$alert" -v tpath="$path" '
function emit(n, v) { gsub(/\047/, "\047\"\047\"\047", v); printf "%s=\047%s\047\n", n, v }
function strip_comment(s,   i, n, c, nx, out) {
	out = ""
	n = length(s)
	for (i = 1; i <= n; i++) {
		c = substr(s, i, 1)
		if (c == "\\") {
			nx = substr(s, i + 1, 1)
			if (nx == "#") { out = out "#"; i++ }
			else out = out c
		}
		else if (c == "#") break
		else out = out c
	}
	return out
}
function onpath(   i) {
	if (depth > nparts) return 0
	for (i = 1; i <= depth; i++) if (part[i] != pth[i]) return 0
	return 1
}
BEGIN { nparts = split(tpath, part, ".") }
{
	# Config::Grammar treats everything from an unescaped # as a comment,
	# wherever it appears - Debian ships "binary = /usr/bin/fping # mandatory"
	s = strip_comment($0)
	sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s)
	if (s == "") next

	if (s ~ /^\*\*\*.*\*\*\*$/) {
		sub(/^\*\*\*[ \t]*/, "", s); sub(/[ \t]*\*\*\*$/, "", s)
		section = s; depth = 0
		next
	}
	if (substr(s, 1, 1) == "+") {
		n = 0
		while (substr(s, n + 1, 1) == "+") n++
		nm = substr(s, n + 1)
		sub(/^[ \t]+/, "", nm); sub(/[ \t]+$/, "", nm)
		depth = n; pth[n] = nm
		next
	}

	eq = index(s, "=")
	if (eq > 1) {
		k = substr(s, 1, eq - 1); v = substr(s, eq + 1)
		sub(/[ \t]+$/, "", k); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v)
		if (k !~ /^[A-Za-z_][A-Za-z0-9_]*$/) next

		if (section == "General" && depth == 0) {
			if (k == "cgiurl")       emit("SP_CGIURL", v)
			else if (k == "datadir") emit("SP_DATADIR", v)
			else if (k == "contact") emit("SP_CONTACT", v)
			else if (k == "owner")   emit("SP_OWNER", v)
			else if (k == "display_name") emit("SP_DISPLAY", v)
			else if (k == "sendmail")     emit("SP_SENDMAIL", v)
			else if (k == "mailhost")     emit("SP_MAILHOST", v)
			else if (k == "mailuser")     emit("SP_MAILUSER", v)
			else if (k == "mailpass")     emit("SP_MAILPASS", v)
		}
		else if (section == "Alerts") {
			if (depth == 0 && k == "to")        emit("SP_TO_ALL", v)
			else if (depth == 0 && k == "from") emit("SP_FROM", v)
			else if (depth == 1 && pth[1] == alert && k == "to") emit("SP_TO_ALERT", v)
		}
		else if (section == "Targets" && onpath()) {
			if (k == "alertee")    emit("SP_ALERTEE", v)
			else if (k == "probe") probe = v
		}
		else if (section == "Probes") {
			# module level, and probe instances one level below it
			if (depth == 1) pv[pth[1] SUBSEP k] = v
			else if (depth == 2) {
				pv[pth[1] "/" pth[2] SUBSEP k] = v
				mod[pth[2]] = pth[1]
			}
		}
		else if (section == "Database" && depth == 0 && k == "pings") emit("SP_PINGS", v)
		else if (section == "Presentation" && depth == 1 && pth[1] == "detail") {
			if (k == "width")       emit("SP_WIDTH", v)
			else if (k == "height") emit("SP_HEIGHT", v)
		}
		next
	}

	# the detail time ranges are a two column table, "Last 3 Hours"  3h;
	# the first row is what the CGI opens on, so it is what we draw
	if (section == "Presentation" && depth == 1 && pth[1] == "detail" && !gotrange) {
		if (s ~ /^"/) { sub(/^"[^"]*"[ \t]*/, "", s) } else { sub(/^[^ \t]+[ \t]+/, "", s) }
		sub(/[ \t].*$/, "", s)
		if (s ~ /^[0-9]+[smhdwy]?$/) { emit("SP_RANGE", s); gotrange = 1 }
	}
}
END {
	if (probe == "") exit
	emit("SP_PROBE", probe)
	# a probe named on a target is either a module section or an instance
	# under one, and an instance inherits the module section s settings
	inst = (probe in mod) ? mod[probe] "/" probe : probe
	base = (probe in mod) ? mod[probe] : ""
	split("rhost ruser rport binary", want, " ")
	for (i = 1; i <= 4; i++) {
		val = ""
		if ((inst SUBSEP want[i]) in pv) val = pv[inst SUBSEP want[i]]
		else if (base != "" && (base SUBSEP want[i]) in pv) val = pv[base SUBSEP want[i]]
		if (val != "") emit("SP_PROBE_" toupper(want[i]), val)
	}
}')"

SP_CGIURL=${SP_CGIURL:-} SP_DATADIR=${SP_DATADIR:-} SP_CONTACT=${SP_CONTACT:-}
SP_OWNER=${SP_OWNER:-} SP_DISPLAY=${SP_DISPLAY:-} SP_SENDMAIL=${SP_SENDMAIL:-}
SP_MAILHOST=${SP_MAILHOST:-} SP_MAILUSER=${SP_MAILUSER:-} SP_MAILPASS=${SP_MAILPASS:-}
SP_FROM=${SP_FROM:-} SP_TO_ALL=${SP_TO_ALL:-} SP_TO_ALERT=${SP_TO_ALERT:-}
SP_ALERTEE=${SP_ALERTEE:-} SP_PINGS=${SP_PINGS:-20}
SP_WIDTH=${SP_WIDTH:-600} SP_HEIGHT=${SP_HEIGHT:-200} SP_RANGE=${SP_RANGE:-3h}
SP_PROBE=${SP_PROBE:-} SP_PROBE_RHOST=${SP_PROBE_RHOST:-}
SP_PROBE_RUSER=${SP_PROBE_RUSER:-} SP_PROBE_RPORT=${SP_PROBE_RPORT:-}
SP_PROBE_BINARY=${SP_PROBE_BINARY:-}

# --------------------------------------------------------------- recipients ---

# SmokePing itself notifies Alerts/to plus the target s alertee plus the alert s
# own to, so collect the same three and drop the entries that are not mail: our
# own pipe, and the snpp:/xmpp: transports.
recipients=''
for a in $(printf '%s,%s,%s' "$SP_TO_ALL" "$SP_TO_ALERT" "$SP_ALERTEE" | tr ',' ' '); do
	case $a in
		'|'*|'snpp:'*|'xmpp:'*|'') continue ;;
		*@*) ;;
		*) continue ;;
	esac
	case ",$recipients," in *",$a,"*) continue ;; esac
	recipients="${recipients:+$recipients,}$a"
done
[ -n "$recipients" ] || recipients=$SP_CONTACT
[ -n "$recipients" ] || die "no recipient: no mail address in Alerts/to, alertee or General/contact"

info "config $CONFIG: recipients=$recipients mailhost=${SP_MAILHOST:-none} sendmail=${SP_SENDMAIL:-unset} datadir=${SP_DATADIR:-unset}"
name=${SP_DISPLAY:-${SP_OWNER:-$localhost}}
from_addr=${SP_FROM:-smokeping@$localhost}
from_name=${SP_OWNER:-$SP_DISPLAY}

# ------------------------------------------------------------ window, RRD, URL ---

window=$(awk -v r="$SP_RANGE" 'BEGIN{
	n = r; u = "h"
	if (r ~ /[smhdwy]$/) { u = substr(r, length(r)); n = substr(r, 1, length(r) - 1) }
	m = 3600
	if (u == "s") m = 1
	else if (u == "m") m = 60
	else if (u == "d") m = 86400
	else if (u == "w") m = 604800
	else if (u == "y") m = 31536000
	printf "%d\n", n * m }') || window=''
case $window in ''|0|*[!0-9]*) window=10800 ;; esac
start=$((now - window))

# One target, one RRD: the target path with its dots turned into directory
# separators under datadir. A distributed setup is the single exception - there
# a reporting instance gets its own file - so that name is tried first when the
# alert named one, and only if it is really there.
rrd='' suffix=''
if [ -n "$SP_DATADIR" ]; then
	base="$SP_DATADIR/$(printf '%s' "$path" | tr . /)"
	candidates=".rrd"
	[ -n "$reporter" ] && candidates="~$reporter.rrd $candidates"
	for c in $candidates; do
		[ -r "$base$c" ] || continue
		rrd="$base$c" suffix=${c%.rrd}
		break
	done
	if [ -z "$rrd" ]; then
		# say what is actually in that directory, so a wrong datadir or
		# an unexpected layout is visible instead of guessed at
		found='' n=0
		for f in "${base%/*}"/*.rrd; do
			[ -e "$f" ] || continue
			n=$((n + 1))
			[ "$n" -le 12 ] && found="$found ${f##*/}"
		done
		[ "$n" -gt 12 ] && found="$found ... ($n files)"
		warn "no RRD for $path in ${base%/*}; that directory holds:${found:- no .rrd files}"
	fi
fi

if [ -n "$SP_CGIURL" ]; then
	# the target's own page, exactly as SmokePing's stock alert mail links it
	url="${SP_CGIURL%%[?&]}?target=${path}${suffix}"
else
	url=''
	warn "General/cgiurl is not set, no graph link"
fi

# --------------------------------------------------------------- graph PNG ---

tmp=$(mktemp -d "${TMPDIR:-/tmp}/$PROG.XXXXXX") || die "mktemp failed"
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
png="$tmp/graph.png"

# Render the RRD the way SmokePing's CGI does: grey "smoke" bands between the
# fastest and slowest ping of each sample, and a median line coloured by the
# packet loss of that sample.
graph_rrd() {
	[ -n "$rrd" ] || return 1
	pings=$("$RRDTOOL" info "$rrd" 2>/dev/null |
		sed -n 's/^ds\[ping\([0-9][0-9]*\)\].*/\1/p' | sort -n | tail -n 1)
	[ -n "$pings" ] || pings=$SP_PINGS

	set -- "$png" --imgformat PNG --start "$start" --end now \
		--width "$SP_WIDTH" --height "$SP_HEIGHT" --slope-mode \
		--lower-limit 0 --vertical-label seconds --title "$target" \
		"DEF:median=$rrd:median:AVERAGE" "DEF:loss=$rrd:loss:AVERAGE"

	i=1
	while [ "$i" -le "$pings" ]; do
		set -- "$@" "DEF:ping$i=$rrd:ping$i:AVERAGE"
		i=$((i + 1))
	done

	# the smoke itself, ported from Smokeping::smokecol()
	ibot=1 itop=$pings
	while [ "$itop" -gt "$ibot" ]; do
		c=$(awk -v p="$pings" -v b="$ibot" \
			'BEGIN{h=p/2;printf "%02x",int(190/h*(h-b))+50}')
		set -- "$@" \
			"CDEF:smoke$ibot=ping$ibot,UN,UNKN,ping$itop,ping$ibot,-,IF" \
			"AREA:ping$ibot" "STACK:smoke$ibot#$c$c$c"
		ibot=$((ibot + 1)) itop=$((itop - 1))
	done

	# median line, split into SmokePing's default loss colour buckets
	buckets=$(awk -v p="$pings" 'function m(a,b){return a>b?a:b} BEGIN{
		printf "0:26ff00 %d:00b8ff %d:0059ff %d:7e00ff %d:ff00ff %d:ff5500 %d:ff0000 %d:a00000\n",
		m(int(0.01*p),1), m(int(0.05*p),2), m(int(0.10*p),3),
		m(int(0.25*p),4), m(int(0.50*p),5), p-1, p }')
	last=-1
	for b in $buckets; do
		n=${b%%:*} col=${b#*:}
		[ "$n" -gt "$pings" ] && continue
		[ "$n" -le "$last" ] && continue
		nxt=$((last + 1))
		if [ "$n" = 0 ]; then lbl=0
		elif [ "$nxt" = "$n" ]; then lbl=$n
		else lbl="$nxt-$n"
		fi
		set -- "$@" \
			"CDEF:me$n=loss,$last,GT,loss,$n,LE,*,1,UNKN,IF,median,*" \
			"LINE2:me$n#$col:$lbl "
		last=$n
	done

	set -- "$@" 'COMMENT:\l' "CDEF:ploss=loss,$pings,/,100,*" \
		'GPRINT:median:AVERAGE:median rtt\: %.1lf %ss avg' \
		'GPRINT:median:MAX:%.1lf %ss max' \
		'GPRINT:median:LAST:%.1lf %ss now\l' \
		'GPRINT:ploss:AVERAGE:packet loss\: %.2lf %% avg' \
		'GPRINT:ploss:MAX:%.2lf %% max' \
		'GPRINT:ploss:LAST:%.2lf %% now\l'

	"$RRDTOOL" graph "$@" >/dev/null
}

# SmokePing draws its graphs through the RRDs perl module, so the rrdtool
# command line binary is not necessarily installed alongside it. Look past
# PATH as well, since a daemon's PATH is often minimal.
RRDTOOL=$(command -v rrdtool 2>/dev/null) || RRDTOOL=''
if [ -z "$RRDTOOL" ]; then
	for r in /usr/bin/rrdtool /usr/local/bin/rrdtool /usr/sbin/rrdtool \
	         /usr/local/rrdtool/bin/rrdtool /opt/rrdtool/bin/rrdtool; do
		[ -x "$r" ] && { RRDTOOL=$r; break; }
	done
fi

b64='' why=''
if [ -z "$RRDTOOL" ]; then
	why="the rrdtool binary was not found (SmokePing itself only needs the RRDs perl module, so rrdtool may not be installed)"
elif [ -z "$SP_DATADIR" ]; then
	why="General/datadir is not set in $CONFIG"
elif [ -z "$rrd" ]; then
	why="no RRD found for $path, see the warning above"
elif ! graph_rrd || [ ! -s "$png" ]; then
	why="rrdtool graph produced nothing from $rrd"
else
	b64=$(base64 "$png" 2>/dev/null) ||
	b64=$(openssl base64 -in "$png" 2>/dev/null) || b64=''
	[ -n "$b64" ] || why="neither base64 nor openssl could encode the PNG"
fi
[ -n "$b64" ] || warn "no graph embedded, sending text only: $why"

# --------------------------------------------------------------------- mtr ---

run_mtr() {
	if [ "$MTR_TIMEOUT" -gt 0 ] && command -v timeout >/dev/null 2>&1; then
		timeout "$MTR_TIMEOUT" "$@" 2>&1
	else
		"$@" 2>&1
	fi
}

mtr_note=''
if [ -n "$SP_PROBE_RHOST" ]; then
	# The probe measures from somewhere else, so trace from there too, using
	# the same transport and credentials the probe itself uses:
	#   binary [-l ruser] [-p rport] rhost <command>
	rbin=${SP_PROBE_BINARY:-ssh}
	set -- "$rbin"
	case ${rbin##*/} in
		*ssh*) set -- "$@" -n -o BatchMode=yes -o ConnectTimeout=10 ;;
	esac
	[ -n "$SP_PROBE_RUSER" ] && set -- "$@" -l "$SP_PROBE_RUSER"
	[ -n "$SP_PROBE_RPORT" ] && set -- "$@" -p "$SP_PROBE_RPORT"
	# shellcheck disable=SC2086
	set -- "$@" "$SP_PROBE_RHOST" mtr $MTR_OPTS -- "$host"

	measured_by="probe $SP_PROBE on $SP_PROBE_RHOST"
	mtr_command="${rbin##*/}${SP_PROBE_RUSER:+ -l $SP_PROBE_RUSER}"
	mtr_command="$mtr_command${SP_PROBE_RPORT:+ -p $SP_PROBE_RPORT}"
	mtr_command="$mtr_command $SP_PROBE_RHOST mtr $MTR_OPTS $host"

	mtr_output=$(run_mtr "$@") || {
		mtr_note="could not run MTR on $SP_PROBE_RHOST (exit $?):
$mtr_output

falling back to a trace from $localhost, which does not take the same path
as the probe that measured the loss:"
		measured_by="$localhost (probe $SP_PROBE on $SP_PROBE_RHOST could not be reached)"
		mtr_command="mtr $MTR_OPTS $host"
		# shellcheck disable=SC2086
		mtr_output=$(run_mtr mtr $MTR_OPTS -- "$host") ||
			mtr_output="error running MTR (exit $?):
$mtr_output"
	}
else
	measured_by="${SP_PROBE:+probe $SP_PROBE on }$localhost"
	[ -n "$reporter" ] && mtr_note="the alert was reported by $reporter, but this
trace is from $localhost:"
	mtr_command="mtr $MTR_OPTS $host"
	# shellcheck disable=SC2086
	mtr_output=$(run_mtr mtr $MTR_OPTS -- "$host") ||
		mtr_output="error running MTR (exit $?):
$mtr_output"
fi

# -------------------------------------------------------------------- mail ---

subject="$name SmokePing alert: $target"
state_line=''
case $state in
	1) subject="$name SmokePing alert raised: $target"
	   state_line="
State: raised" ;;
	0) subject="$name SmokePing alert cleared: $target"
	   state_line="
State: cleared" ;;
esac

LC_ALL=C
export LC_ALL

# RFC 2047 for the header words that come out of the config and may not be
# ASCII - a non-ASCII owner would otherwise corrupt the header
mimeword() {
	if is_ascii "$1"; then
		printf '%s' "$1"
	else
		printf '=?UTF-8?B?%s?=' "$(printf '%s' "$1" | base64 | tr -d '\n')"
	fi
}
subject=$(mimeword "$subject")
if [ -z "$from_name" ]; then
	from=$from_addr
elif is_ascii "$from_name"; then
	from="\"$(printf '%s' "$from_name" | sed 's/[\\"]/\\&/g')\" <$from_addr>"
else
	from="$(mimeword "$from_name") <$from_addr>"
fi

stamp=$(date '+%c')
text="Packet loss report from $name for $target at $stamp.
Measured by: $measured_by"
[ -n "$url" ] && text="$text

$url"
[ -n "$mtr_note" ] && text="$text

$mtr_note"
text="$text

$mtr_command

$mtr_output

Alert triggered: $alert
Target: $target
Target hostname: $host
Loss pattern: ${loss#* }
RTT: ${rtt#* }$state_line"

extra_headers=''
if [ -n "$SP_PROBE" ]; then
	extra_headers="
X-SmokePing-Probe: $SP_PROBE"
	[ -n "$SP_PROBE_RHOST" ] && extra_headers="$extra_headers on $SP_PROBE_RHOST"
fi
[ -n "$rrd" ] && extra_headers="$extra_headers
X-SmokePing-RRD: $rrd"

date_hdr=$(date '+%a, %d %b %Y %H:%M:%S %z')
headers="From: $from
To: $recipients
Subject: $subject
Date: $date_hdr
Message-ID: <$now.$$@$localhost>
MIME-Version: 1.0
Auto-Submitted: auto-generated
Precedence: bulk
X-SmokePing-Alert: $alert
X-SmokePing-Target: $target$extra_headers"

msg="$tmp/message"

if [ -z "$b64" ]; then
	cat > "$msg" <<EOF
$headers
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

$text
EOF
else
	# multipart/related, so the graph is shown inline rather than as an
	# attachment, wrapping a multipart/alternative for text only clients
	rel="=_rel_${now}_$$" alt="=_alt_${now}_$$" cid="graph.${now}.$$@$localhost"

	# everything is escaped into a variable up here, so the heredoc below is
	# a plain template: no command substitution and no ${var:+...} inside it,
	# both of which behave badly in a heredoc on older shells
	e_name=$(esc "$name")
	e_target=$(esc "$target")
	e_measured=$(esc "$measured_by")
	e_command=$(esc "$mtr_command")
	e_output=$(esc "$mtr_output")
	e_alert=$(esc "$alert")
	e_host=$(esc "$host")
	e_loss=$(esc "${loss#* }")
	e_rtt=$(esc "${rtt#* }")
	e_state=$(esc "$state_line")

	html_img="<img src=\"cid:$cid\" alt=\"SmokePing graph\" style=\"max-width:100%;border:0\">"
	# the link text is the URL itself, so it stays clickable without hiding
	# the address behind a caption
	html_link=''
	if [ -n "$url" ]; then
		u=$(esc "$url")
		html_link="<p><a href=\"$u\">$u</a></p>"
	fi
	html_note=''
	if [ -n "$mtr_note" ]; then
		html_note="<p><b>$(esc "$mtr_note")</b></p>"
	fi

	cat > "$msg" <<EOF
$headers
Content-Type: multipart/related; type="multipart/alternative"; boundary="$rel"

--$rel
Content-Type: multipart/alternative; boundary="$alt"

--$alt
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

$text

--$alt
Content-Type: text/html; charset=UTF-8
Content-Transfer-Encoding: 8bit

<html><body style="font-family:sans-serif">
<p>Packet loss report from <b>$e_name</b> for
<b>$e_target</b> at $stamp.<br>
Measured by: $e_measured</p>
$html_link
<p>$html_img</p>
$html_note
<pre style="font-size:small">$e_command

$e_output</pre>
<pre style="font-size:small">Alert triggered: $e_alert
Target: $e_target
Target hostname: $e_host
Loss pattern: $e_loss
RTT: $e_rtt$e_state</pre>
</body></html>

--$alt--

--$rel
Content-Type: image/png; name="smokeping.png"
Content-Disposition: inline; filename="smokeping.png"
Content-ID: <$cid>
Content-Transfer-Encoding: base64

$b64

--$rel--
EOF
fi

[ -n "$DRY_RUN" ] && { cat "$msg"; exit 0; }

# General/mailhost is what SmokePing uses in place of a local MTA, so honour it
# the same way; several comma separated hosts may be given.
send_smtp() {
	[ -n "$SP_MAILHOST" ] || return 1
	if ! command -v curl >/dev/null 2>&1; then
		warn "General/mailhost is set but curl is not installed, using a local MTA instead"
		return 1
	fi
	# SMTP is a CRLF protocol and curl does not convert line endings, so a
	# message written with bare LF can be mangled or refused by the server
	smtpmsg="$tmp/message.smtp"
	awk '{ printf "%s\r\n", $0 }' "$msg" > "$smtpmsg" || return 1
	for h in $(printf '%s' "$SP_MAILHOST" | tr ',' ' '); do
		set -- --silent --show-error --url "smtp://$h" \
			--mail-from "$from_addr" --upload-file "$smtpmsg"
		for r in $(printf '%s' "$recipients" | tr ',' ' '); do
			set -- "$@" --mail-rcpt "$r"
		done
		[ -n "$SP_MAILUSER" ] && set -- "$@" --user "$SP_MAILUSER:$SP_MAILPASS"
		if curl "$@"; then
			info "delivered to $recipients over smtp via $h"
			return 0
		fi
		warn "smtp delivery via $h failed"
	done
	return 1
}

# SmokePing prefers General/mailhost over a local MTA, so do the same
send_smtp && exit 0
[ -n "$SP_MAILHOST" ] && warn "no smtp host accepted the message, falling back to a local MTA"

sendmail=$SP_SENDMAIL
if [ -n "$sendmail" ] && [ ! -x "$sendmail" ]; then
	warn "General/sendmail is $sendmail, which is not executable; looking elsewhere"
	sendmail=''
fi
if [ -z "$sendmail" ]; then
	for s in /usr/sbin/sendmail /usr/lib/sendmail /usr/sbin/exim4 /usr/sbin/exim; do
		[ -x "$s" ] && { sendmail=$s; break; }
	done
fi
[ -n "$sendmail" ] || sendmail=$(command -v sendmail) ||
	die "no MTA found and no usable General/mailhost"

info "handing the message to $sendmail for $recipients"
"$sendmail" -f "$from_addr" -t -oi < "$msg" ||
	die "$sendmail exited $? without accepting the message"
info "accepted by $sendmail"
